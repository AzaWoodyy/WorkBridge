{
  "name": "workbridge",
  "private": true,
  "version": "0.1.6",
  "main": "dist/main/index.cjs",
  "type": "module",
  "description": "WorkBridge desktop app",
  "author": "Enzo Neault",
  "scripts": {
    "dev": "env -u ELECTRON_RUN_AS_NODE electron-vite dev",
    "build": "electron-vite build",
    "preview": "env -u ELECTRON_RUN_AS_NODE electron-vite preview",
    "pack:mac": "node scripts/set-version.cjs && electron-vite build && electron-builder --mac",
    "postinstall": "electron-builder install-app-deps",
    "lint": "eslint src",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "test:reliability": "vitest run tests/sync.test.ts",
    "demo": "WORKBRIDGE_DEMO=1 env -u ELECTRON_RUN_AS_NODE electron-vite dev",
    "format": "prettier --write src",
    "format:check": "prettier --check src",
    "test": "vitest run",
    "test:prepare": "npm rebuild better-sqlite3"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.2",
    "@radix-ui/react-dropdown-menu": "^2.1.2",
    "@radix-ui/react-icons": "^1.3.2",
    "@radix-ui/react-popover": "^1.1.2",
    "@radix-ui/react-slot": "^1.0.2",
    "@tanstack/react-query": "^5.51.24",
    "better-sqlite3": "^11.1.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.36.4",
    "emoji-toolkit": "^9.0.1",
    "keytar": "^7.9.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^9.0.1",
    "remark-emoji": "^4.0.0",
    "remark-gfm": "^4.0.0",
    "tailwind-merge": "^2.4.0",
    "zod": "^3.23.8",
    "zustand": "^4.5.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "electron": "^31.2.0",
    "electron-builder": "^24.13.3",
    "electron-rebuild": "^3.2.9",
    "electron-vite": "^2.3.0",
    "eslint": "^10.14.0",
    "postcss": "^8.4.41",
    "prettier": "^3.10.0",
    "tailwindcss": "^3.4.10",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.72.2",
    "vite": "^5.4.2",
    "vitest": "^3.2.7"
  },
  "productName": "WorkBridge",
  "build": {
    "appId": "com.workbridge.app",
    "productName": "WorkBridge",
    "files": [
      "dist/**",
      "package.json"
    ],
    "directories": {
      "buildResources": "build"
    },
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "build/icon.png",
      "target": "dmg"
    },
    "buildVersion": "0.1.6+c01473f"
  }
}
